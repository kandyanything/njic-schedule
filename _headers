# Cloudflare Pages headers. Calendar feeds must serve as text/calendar so
# webcal:// subscriptions work; short cache so subscribers pick up changes.
/feeds/all.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=1800
# extension-specific so the .ics and .xml feeds in these folders don't both
# match one rule (Cloudflare merges matching headers rather than overriding).
/feeds/schools/*.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=1800
/feeds/sports/*.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=1800
/feeds/schools/*.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800
/feeds/sports/*.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800
/feeds/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800
/data/schedule/*
  Cache-Control: public, max-age=1800
/feeds/teams/*
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=1800
